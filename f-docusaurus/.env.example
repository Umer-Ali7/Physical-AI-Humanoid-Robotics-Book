# Auth Server Environment Variables

# PostgreSQL Database URL (from Neon.tech)
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Auth Secret (must be at least 32 characters)
BETTER_AUTH_SECRET=your_random_secret_here_at_least_32_characters_long_123456

# Server URL (update with your production domain)
BETTER_AUTH_URL=http://localhost:5000

# Port (default: 5000)
PORT=5000

# Node Environment
NODE_ENV=development

# Frontend URL for CORS (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:3000
